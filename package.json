{
  "name": "dsh-go-workbuddy-connect",
  "version": "0.1.0",
  "private": true,
  "description": "dsh-go native plugin: connect WorkBuddy credits (browser sign-in) to the phone engine with tools, a credits strip and a native panel.",
  "author": "WorkBuddy user build",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "WorkBuddy 积分",
      "en": "WorkBuddy Credits"
    },
    "icon": "coin",
    "contributes": {
      "composer.actions": [
        {
          "id": "wb-open",
          "label": {
            "zh": "WorkBuddy",
            "en": "WorkBuddy"
          },
          "icon": "coin",
          "effect": {
            "type": "open",
            "page": "panel:workbuddy"
          }
        }
      ],
      "composer.strip": [
        {
          "id": "wb-credits",
          "icon": "coin",
          "panel": "workbuddy"
        }
      ],
      "panels": [
        {
          "id": "workbuddy",
          "title": {
            "zh": "WorkBuddy 积分",
            "en": "WB Credits"
          },
          "icon": "coin",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}
